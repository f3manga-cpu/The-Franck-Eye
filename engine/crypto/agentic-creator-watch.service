[Unit]
Description=Mission C - read-only creator market signal collector
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/franck/agentic-creator-lab
ExecStart=/usr/bin/python3 -u /home/franck/agentic-creator-lab/public_market_watch.py loop
Restart=always
RestartSec=30
MemoryMax=96M
CPUQuota=10%
Nice=12
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
